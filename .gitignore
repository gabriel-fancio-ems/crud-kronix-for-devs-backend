# ---------------------------------------------------------------------------
secrets.json
appsettings.*.local.json
appsettings.Local.json
*.pfx
*.p12
*.key
*.pem
*.crt
*.cer
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Outras IDEs e ferramentas
# ---------------------------------------------------------------------------
# JetBrains Rider
.idea/
*.sln.iml
# VS Code (mantém configurações úteis compartilhadas)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
# Ferramentas de IA locais
.claude/
.cursor/

